# API key required on every REST request (X-API-Key header) and WebSocket
# connection (?token= query param). Strongly recommended — leaving this unset
# runs with NO auth at all (a startup warning prints every time). Generate one
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# LLM Provider — choose one: gemini | openai | anthropic | ollama | cerebras | glm
LLM_PROVIDER=gemini

# API Keys (only the one matching LLM_PROVIDER is required)
GEMINI_API_KEY=AIza...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_VISION_MODEL=qwen2.5vl        # local vision model to pull via `ollama pull qwen2.5vl`
# OLLAMA_TEXT_MODEL=qwen2.5:7b         # local text model to pull via `ollama pull qwen2.5:7b`
# CEREBRAS_API_KEY=csk-...             # free tier key from cloud.cerebras.ai (text-only, no vision)
# CEREBRAS_MODEL=llama-3.3-70b
# GLM_API_KEY=...                      # free tier key from open.bigmodel.cn (Zhipu AI, has vision)
# GLM_VISION_MODEL=glm-4v-flash
# GLM_TEXT_MODEL=glm-4-flash

# Android device serial — mostly vestigial now: the backend connects to EVERY device
# `adb devices` sees at startup (backend/device/registry.py), not just this one.
# Target a specific device per-request instead via device_serial in the Explore/Deploy body.
ANDROID_SERIAL=emulator-5554

# ChromaDB — used by Docker Compose; leave as-is for local dev
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Neo4j — navigation graph for Explore mode (backend/graph/neo4j_client.py).
# Defaults already match docker-compose's neo4j service; only uncomment to override.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=learnGraph123

# Langfuse — optional LLM observability (traces/spans/token+cost tracking). Leave
# unset to disable entirely (zero behavior change, zero network calls). Langfuse
# Cloud's free tier works fine without self-hosting — get keys at cloud.langfuse.com.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# Approximate $/1M-token overrides for cost estimation (backend/llm/pricing.py).
# Defaults are placeholders — verify against each provider's real pricing page.
# PRICE_GEMINI_INPUT_PER_1M=0.075
# PRICE_GEMINI_OUTPUT_PER_1M=0.30
# PRICE_OPENAI_INPUT_PER_1M=2.50
# PRICE_OPENAI_OUTPUT_PER_1M=10.00
# PRICE_ANTHROPIC_INPUT_PER_1M=3.00
# PRICE_ANTHROPIC_OUTPUT_PER_1M=15.00
