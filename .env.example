# LLM Provider — choose one: gemini | openai | anthropic | ollama
LLM_PROVIDER=gemini

# API Keys (only the one matching LLM_PROVIDER is required)
GEMINI_API_KEY=AIza...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_BASE_URL=http://localhost:11434

# Android device serial (leave empty to auto-detect single connected device)
# Examples: emulator-5554  (Android Studio)  |  R58N12345  (physical Samsung)
ANDROID_SERIAL=emulator-5554

# ChromaDB — used by Docker Compose; leave as-is for local dev
CHROMA_HOST=localhost
CHROMA_PORT=8001
